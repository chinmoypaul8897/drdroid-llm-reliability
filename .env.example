# ---------------------------------------------------------------------------
# Environment variables used by this repo.
#
# Nothing here is read globally — each component reads its own subset:
#   scripts/benchmark/   reads a .env in that directory (via dotenv)
#   scripts/ollama-exporter/  reads the process environment, set in k8s/ollama.yaml
#   ui/                  reads VITE_* at BUILD time, not at runtime
#
# Copy the section you need. Never commit a filled-in copy.
# ---------------------------------------------------------------------------


# === scripts/benchmark — copy to scripts/benchmark/.env ====================

# OpenAI API key used for both the commercial responses and the judging pass.
# REQUIRED. Both benchmark.ts and judge.ts exit(1) immediately without it.
# The full 10-prompt run cost $0.0015 at gpt-4o-mini pricing.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where benchmark.ts reaches the local model.
# Optional — defaults to http://localhost:11434.
# Set this if you are port-forwarding the in-cluster Ollama to another port.
OLLAMA_URL=http://localhost:11434

# Open-source model tag pulled into Ollama.
# Optional — defaults to llama3.2:1b. Must already be pulled, or every OSS run
# errors out and the judge records 0/15 for that prompt.
OSS_MODEL=llama3.2:1b

# Commercial model benchmarked against the OSS one.
# Optional — defaults to gpt-4o-mini. Note: cost is computed from a hardcoded
# pricing table in benchmark.ts that knows only gpt-4o-mini and gpt-4o. Any
# other model runs fine but is costed at $0.
COMMERCIAL_MODEL=gpt-4o-mini

# Model used to score the two response sets.
# Optional — defaults to gpt-4o-mini, which is also the commercial respondent.
# Leaving it at the default is what makes the self-bias disclosure necessary;
# set a different family here for a fairer comparison.
JUDGE_MODEL=gpt-4o-mini


# === scripts/ollama-exporter — set via env in k8s/ollama.yaml ==============

# Ollama base URL. Optional — defaults to http://localhost:11434, which is
# correct for the sidecar because it shares the pod's network namespace.
# OLLAMA_URL=http://localhost:11434

# Port the /metrics and /healthz endpoints listen on.
# Optional — defaults to 9101. Changing it breaks the containerPort, the
# Service port, and the ServiceMonitor unless you change those too.
METRICS_PORT=9101

# Seconds between poll cycles. Optional — the exporter's own default is 10,
# but k8s/ollama.yaml overrides it to 30 to reduce CPU contention with the
# model. Lowering it makes the histogram denser and inference slower.
POLL_INTERVAL=30

# Model the synthetic probe generates against.
# Optional — defaults to llama3.2:1b. If this doesn't match a pulled model,
# every probe fails and ollama_probe_errors_total climbs continuously.
PROBE_MODEL=llama3.2:1b

# Prompt used for the synthetic probe. Optional — defaults to "Hi".
# Kept trivially short on purpose; the probe caps generation at 5 tokens.
PROBE_PROMPT=Hi


# === ui — build-time only, consumed by Vite ===============================

# Base URL the browser posts /api/chat to.
# Optional — defaults to "" (empty), which makes the request same-origin so
# nginx inside the chat-ui pod proxies it to the Ollama Service. Leave it
# unset for the Kubernetes deployment. Set it only for local dev against a
# different host. Anything here is baked into the bundle at build time and is
# publicly visible — never put a secret in a VITE_ variable.
VITE_OLLAMA_URL=

# Model name displayed in the chat header and sent in the request body.
# Optional — defaults to llama3.2:1b.
VITE_MODEL=llama3.2:1b
